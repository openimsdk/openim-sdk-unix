type NativeOpenIMInitConfig = {
  platformID : number
  apiAddr : string
  wsAddr : string
  dataDir : string
  logFilePath : string
  logLevel : number
  isLogStandardOutput : boolean
  systemType : string
}

function normalizeWritablePath(path : string | null) : string {
  if (path == null || path.length == 0 || path.indexOf('unifile:') >= 0) {
    return UTSiOS.getDataPath()
  }
  return path
}

export function getOpenIMDataPathNative() : string {
  return UTSiOS.getDataPath()
}

export function normalizeInitConfig(config : OpenIMInitConfig) : string {
  const nativeConfig : NativeOpenIMInitConfig = {
    platformID: config.platformID,
    apiAddr: config.apiAddr,
    wsAddr: config.wsAddr,
    dataDir: normalizeWritablePath(config.dataDir != null ? config.dataDir as string : null),
    logFilePath: normalizeWritablePath(config.logFilePath != null ? config.logFilePath as string : null),
    logLevel: config.logLevel,
    isLogStandardOutput: config.isLogStandardOutput,
    systemType: config.systemType
  }
  const configText = JSON.stringify(nativeConfig as any)
  if (configText != null) {
    return configText as string
  }
  return '{}'
}

export function parseNativeMessage(data : string) : OpenIMMessageItem | null {
  const message = parseNativeMessageCommon(data, getNativeParserHelpers())
  if (message == null) { return null }
  if (message.content == null || (message.content as string).length == 0) {
    const raw = parseNativeAny(data)
    if (raw instanceof UTSJSONObject) {
      const atTextElem = readNativeValue(raw, 'atTextElem')
      if (atTextElem instanceof UTSJSONObject) {
        const content = JSON.stringify(atTextElem)
        if (content != null) {
          message.content = content as string
        }
      }
    }
  }
  rememberNativeMessageJSON(message, data)
  return message
}

function rememberNativeMessageJSON(message : OpenIMMessageItem, data : string) {
  const trimmed = data.trim()
  if (trimmed.substring(0, 1) != '[') {
    rememberOpenIMMessageJSON(message, trimmed)
    return
  }
  const framed = NativeOpenIMSDK.splitJSONObjectArray(trimmed)
  if (framed == null || (framed as string).length == 0) { return }
  const itemJSON = (framed as string).split('\n')[0]
  rememberOpenIMMessageJSON(message, itemJSON)
}

function rememberNativeMessageListJSON(messages : Array<OpenIMMessageItem>, data : string) {
  const framed = NativeOpenIMSDK.splitJSONObjectArray(data)
  if (framed == null) { return }
  const text = framed as string
  if (text.length == 0) { return }
  const itemJSONList = text.split('\n')
  let index = 0
  while (index < messages.length && index < itemJSONList.length) {
    rememberOpenIMMessageJSON(messages[index], itemJSONList[index])
    index = index + 1
  }
}

export function readStringParam(value : any | null, key : string) : string {
  const raw = readNativeValue(value, key)
  if (raw != null) {
    if (typeof raw == 'string') {
      return raw as string
    }
  }
  return ''
}

export function readNumberParam(value : any | null, key : string) : number {
  const raw = readNativeValue(value, key)
  if (raw != null) {
    if (typeof raw == 'number') {
      return raw as number
    }
  }
  return 0
}

export function readBooleanParam(value : any | null, key : string) : boolean {
  if (value instanceof UTSJSONObject) {
    const parsed = value.getBoolean(key)
    if (parsed != null) { return parsed as boolean }
  }
  const raw = readNativeValue(value, key)
  if (raw != null) {
    if (typeof raw == 'boolean') {
      return raw as boolean
    }
  }
  return false
}

function parseNativeAny(data : string) : any | null {
  const trimmed = data.trim()
  if (trimmed.length == 0) {
    return null
  }
  try {
    return JSON.parse(trimmed)
  } catch (error) {
    return data
  }
}

function parseNativeJSONObjectListData(data : string) : Array<UTSJSONObject> | null {
  const framed = NativeOpenIMSDK.splitJSONObjectArray(data)
  if (framed == null) { return null }
  const framedText = framed as string
  if (framedText.length == 0) { return [] }
  const result : Array<UTSJSONObject> = []
  const itemJSONList = framedText.split('\n')
  let valid = true
  itemJSONList.forEach((itemJSON : string) => {
    const value = JSON.parseObject(itemJSON)
    if (value != null) {
      result.push(value)
    } else {
      valid = false
    }
  })
  return valid ? result : null
}

export { stringifyOpenIMPicture, stringifyOpenIMSoundElem, stringifyOpenIMVideoElem, stringifyOpenIMFileElem, stringifyOpenIMMessage, stringifyOpenIMMessageList, stringifyOpenIMMessagePayload } from '../common/message-json-writer.uts'
}

function isRequiredNumberField(value : UTSJSONObject, key : string) : boolean {
  const raw = readNativeValue(value, key)
  return raw != null && typeof raw == 'number'
}

function isRequiredStringField(value : UTSJSONObject, key : string) : boolean {
  const raw = readNativeValue(value, key)
  return raw != null && typeof raw == 'string'
}

function isRequiredBooleanField(value : UTSJSONObject, key : string) : boolean {
  return value.getBoolean(key) != null
}

function isOptionalNumberField(value : UTSJSONObject, key : string) : boolean {
  const raw = readNativeValue(value, key)
  return raw == null || typeof raw == 'number'
}

function isCommonRequiredField(value : UTSJSONObject, key : string) : boolean {
  if (key == 'isRead' || key == 'isEnd') { return isRequiredBooleanField(value, key) }
  if (key == 'conversationType' || key == 'recvMsgOpt' || key == 'unreadCount' || key == 'latestMsgSendTime' || key == 'draftTextTime' || key == 'burnDuration' || key == 'minSeq' || key == 'maxSeq' || key == 'msgDestructTime' || key == 'groupAtType' || key == 'updateUnreadCountTime' || key == 'status' || key == 'type' || key == 'createTime' || key == 'sendTime' || key == 'sessionType' || key == 'msgFrom' || key == 'contentType' || key == 'senderPlatformID' || key == 'seq' || key == 'revokeTime' || key == 'readTime' || key == 'addSource' || key == 'memberCount' || key == 'groupType' || key == 'needVerification' || key == 'lookMemberInfo' || key == 'applyMemberFriend' || key == 'notificationUpdateTime' || key == 'roleLevel' || key == 'joinTime' || key == 'joinSource' || key == 'muteEndTime' || key == 'handleResult' || key == 'handleTime' || key == 'reqTime' || key == 'handledTime' || key == 'lastMinSeq' || key == 'errCode' || key == 'result') {
    return isRequiredNumberField(value, key)
  }
  return isRequiredStringField(value, key)
}

function parseNativeConversationItemData(data : string) : OpenIMConversationItem | null { return JSON.parseObject<OpenIMConversationItem>(data) }

function parseNativeConversationListData(data : string) : Array<OpenIMConversationItem> | null { return JSON.parseArray<OpenIMConversationItem>(data) }

function parseNativeUserInfoData(data : string) : OpenIMUserInfo | null { return JSON.parseObject<OpenIMUserInfo>(data) }

function parseNativeUserInfoListData(data : string) : Array<OpenIMUserInfo> | null { return JSON.parseArray<OpenIMUserInfo>(data) }

