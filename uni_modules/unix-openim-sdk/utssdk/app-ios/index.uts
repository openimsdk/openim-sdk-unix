function resolveSendMessageData(data : string, apiName : string, resolve : (value : OpenIMMessageItem) => void, reject : (reason : any | null) => void) { // UTS-COMPAT-ALLOW:UTS-BOUNDARY-ANY UTS-COMPAT-CODEC-001
  try {
    const message = parseNativeMessage(data)
    if (message != null) {
      resolve(message)
    } else {
      rejectNativeError(reject, -1, apiName + ' returned invalid message data')
    }
  } catch (error) {
    rejectNativeError(reject, -1, apiName + ' returned unparseable message data: ' + stringifyJSON(error))
  }
}

