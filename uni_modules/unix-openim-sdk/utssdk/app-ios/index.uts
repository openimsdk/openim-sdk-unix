export const createCardMessage = function (card : OpenIMCardElem, operationID ?: string | null) : Promise<OpenIMMessageItem | null> { return new Promise<OpenIMMessageItem | null>((resolve, reject) => { const requestJSON = '{"cardInfo":' + stringifyJSON(stringifyJSON(card)) + '}'; driverCallAsync(2157, normalizeOperationID(operationID), requestJSON, (data : string) => { try { resolve(parseNativeMessage(data)) } catch (error) { rejectNativeError(reject, -1, 'createCardMessage returned unparseable response: ' + stringifyJSON(error)) } }, (errCode : number, errMsg : string) => { rejectNativeError(reject, errCode, errMsg) }) }) }
export const sendMessage = function (options : OpenIMSendMessageOptions) : Promise<OpenIMMessageItem> { return new Promise<OpenIMMessageItem>((resolve, reject) => { const requestJSON = '{"message":' + stringifyJSON(stringifyOpenIMMessage(options.message)) + ',"recvID":' + stringifyJSON(options.recvID) + ',"groupID":' + stringifyJSON(options.groupID) + ',"offlinePushInfo":' + stringifyJSON(readOfflinePushInfo(options)) + ',"isOnlineOnly":' + stringifyJSON(readIsOnlineOnly(options)) + '}'; driverCallAsync(2158, readOperationID(options), requestJSON, (data : string) => { resolveSendMessageData(data, 'sendMessage', resolve, reject) }, (errCode : number, errMsg : string) => { rejectNativeError(reject, errCode, errMsg) }) }) }
export const sendMessageNotOss = function (options : OpenIMSendMessageOptions) : Promise<OpenIMMessageItem> { return new Promise<OpenIMMessageItem>((resolve, reject) => { const requestJSON = '{"message":' + stringifyJSON(stringifyOpenIMMessage(options.message)) + ',"recvID":' + stringifyJSON(options.recvID) + ',"groupID":' + stringifyJSON(options.groupID) + ',"offlinePushInfo":' + stringifyJSON(readOfflinePushInfo(options)) + ',"isOnlineOnly":' + stringifyJSON(readIsOnlineOnly(options)) + '}'; driverCallAsync(2159, readOperationID(options), requestJSON, (data : string) => { resolveSendMessageData(data, 'sendMessageNotOss', resolve, reject) }, (errCode : number, errMsg : string) => { rejectNativeError(reject, errCode, errMsg) }) }) }
export const uploadFile = function (params : OpenIMUploadFileParams, operationID ?: string | null) : Promise<OpenIMUploadFileResult | null> { return new Promise<OpenIMUploadFileResult | null>((resolve, reject) => { const requestJSON = '{"uploadParams":' + stringifyJSON(stringifyJSON(normalizeIOSUploadFileParams(params))) + '}'; driverCallAsync(2160, normalizeOperationID(operationID), requestJSON, (data : string) => { try { resolve(parseNativeUploadFileResult(data)) } catch (error) { rejectNativeError(reject, -1, 'uploadFile returned unparseable response: ' + stringifyJSON(error)) } }, (errCode : number, errMsg : string) => { rejectNativeError(reject, errCode, errMsg) }) }) }
export const uploadLogs = function (params : OpenIMUploadLogsParams, operationID ?: string | null) : Promise<string> { return resolveStringNative((resolve, reject) => { const requestJSON = '{"line":' + stringifyJSON(params.line) + ',"ex":' + stringifyJSON(params.ex) + '}'; driverCallAsync(2161, normalizeOperationID(operationID), requestJSON, resolve, reject) }) }
