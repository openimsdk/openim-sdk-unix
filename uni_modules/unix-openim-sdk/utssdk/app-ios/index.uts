function normalizeIOSLocalMediaPath(path : string) : string {
  if (path.indexOf('unifile://') == 0 || path.indexOf('unifile:') == 0) {
    return UTSiOS.convert2AbsFullPath(path)
  }
  if (path.indexOf('file://') == 0) {
    return path.substring(7)
  }
  return path
}

function normalizeIOSUploadFileParams(params : OpenIMUploadFileParams) : OpenIMUploadFileParams {
  const normalized : OpenIMUploadFileParams = { filepath: normalizeIOSLocalMediaPath(params.filepath), name: params.name, contentType: params.contentType, uuid: params.uuid }
  if (params.cancelID != null) { normalized.cancelID = params.cancelID }
  if (params.cause != null) { normalized.cause = params.cause }
  return normalized
}

