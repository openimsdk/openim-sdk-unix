export function onConnectingEvent(handler : OpenIMVoidEventHandler) : OpenIMSDKUnsubscribe {
  ensureNativeEventsBound()
  const subscriptionID = nextEventHandlerID.toString()
  nextEventHandlerID = nextEventHandlerID + 1
  onConnectingHandlerIDs.push(subscriptionID)
  onConnectingHandlers.push(handler)
  let active : boolean = true
  return () => {
    if (active == false) { return }
    active = false
    removeOnConnectingHandler(subscriptionID)
  }
}

