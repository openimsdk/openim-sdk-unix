      for (let onJoinedGroupAddedDispatchIndex : number = 0; onJoinedGroupAddedDispatchIndex < onJoinedGroupAddedDispatchSnapshot.length; onJoinedGroupAddedDispatchIndex = onJoinedGroupAddedDispatchIndex + 1) {
        const onJoinedGroupAddedDispatchHandler = onJoinedGroupAddedDispatchSnapshot[onJoinedGroupAddedDispatchIndex]
        if (onJoinedGroupAddedDispatchHandler != null) {
          try { onJoinedGroupAddedDispatchHandler(parseNativeGroupObject(payload)) } catch (error) { console.error('[unix-openim-sdk] onJoinedGroupAdded handler failed', error) }
        }
      }
      break

    case 'onJoinedGroupDeleted':
      const onJoinedGroupDeletedDispatchSnapshot : Array<OpenIMGroupEventHandler> = []
      for (let onJoinedGroupDeletedCopyIndex : number = 0; onJoinedGroupDeletedCopyIndex < onJoinedGroupDeletedHandlers.length; onJoinedGroupDeletedCopyIndex = onJoinedGroupDeletedCopyIndex + 1) {
        const onJoinedGroupDeletedCurrentHandler = onJoinedGroupDeletedHandlers[onJoinedGroupDeletedCopyIndex]
        if (onJoinedGroupDeletedCurrentHandler != null) { onJoinedGroupDeletedDispatchSnapshot.push(onJoinedGroupDeletedCurrentHandler) }
      }
      for (let onJoinedGroupDeletedDispatchIndex : number = 0; onJoinedGroupDeletedDispatchIndex < onJoinedGroupDeletedDispatchSnapshot.length; onJoinedGroupDeletedDispatchIndex = onJoinedGroupDeletedDispatchIndex + 1) {
        const onJoinedGroupDeletedDispatchHandler = onJoinedGroupDeletedDispatchSnapshot[onJoinedGroupDeletedDispatchIndex]
        if (onJoinedGroupDeletedDispatchHandler != null) {
          try { onJoinedGroupDeletedDispatchHandler(parseNativeGroupObject(payload)) } catch (error) { console.error('[unix-openim-sdk] onJoinedGroupDeleted handler failed', error) }
        }
      }
      break

    case 'onSelfInfoUpdated':
      const onSelfInfoUpdatedDispatchSnapshot : Array<OpenIMUserEventHandler> = []
      for (let onSelfInfoUpdatedCopyIndex : number = 0; onSelfInfoUpdatedCopyIndex < onSelfInfoUpdatedHandlers.length; onSelfInfoUpdatedCopyIndex = onSelfInfoUpdatedCopyIndex + 1) {
        const onSelfInfoUpdatedCurrentHandler = onSelfInfoUpdatedHandlers[onSelfInfoUpdatedCopyIndex]
        if (onSelfInfoUpdatedCurrentHandler != null) { onSelfInfoUpdatedDispatchSnapshot.push(onSelfInfoUpdatedCurrentHandler) }
      }
      for (let onSelfInfoUpdatedDispatchIndex : number = 0; onSelfInfoUpdatedDispatchIndex < onSelfInfoUpdatedDispatchSnapshot.length; onSelfInfoUpdatedDispatchIndex = onSelfInfoUpdatedDispatchIndex + 1) {
        const onSelfInfoUpdatedDispatchHandler = onSelfInfoUpdatedDispatchSnapshot[onSelfInfoUpdatedDispatchIndex]
        if (onSelfInfoUpdatedDispatchHandler != null) {
          try { onSelfInfoUpdatedDispatchHandler(parseNativeUserObject(payload)) } catch (error) { console.error('[unix-openim-sdk] onSelfInfoUpdated handler failed', error) }
        }
      }
      break

    case 'onUserStatusChanged':
      const onUserStatusChangedDispatchSnapshot : Array<OpenIMUserStatusListEventHandler> = []
      for (let onUserStatusChangedCopyIndex : number = 0; onUserStatusChangedCopyIndex < onUserStatusChangedHandlers.length; onUserStatusChangedCopyIndex = onUserStatusChangedCopyIndex + 1) {
        const onUserStatusChangedCurrentHandler = onUserStatusChangedHandlers[onUserStatusChangedCopyIndex]
        if (onUserStatusChangedCurrentHandler != null) { onUserStatusChangedDispatchSnapshot.push(onUserStatusChangedCurrentHandler) }
      }
      for (let onUserStatusChangedDispatchIndex : number = 0; onUserStatusChangedDispatchIndex < onUserStatusChangedDispatchSnapshot.length; onUserStatusChangedDispatchIndex = onUserStatusChangedDispatchIndex + 1) {
        const onUserStatusChangedDispatchHandler = onUserStatusChangedDispatchSnapshot[onUserStatusChangedDispatchIndex]
        if (onUserStatusChangedDispatchHandler != null) {
          try { onUserStatusChangedDispatchHandler(parseNativeUserStatusEventList(payload)) } catch (error) { console.error('[unix-openim-sdk] onUserStatusChanged handler failed', error) }
        }
      }
      break

    default:
      console.error('[unix-openim-sdk] ignored unknown native event: ' + eventName)
      break
  }
}

function bindNativeEvents() {
  NativeOpenIMSDK.bindNativeEvents((eventName : string, payload : string, errCode : number, errMsg : string) => {
    emitSDKEvent(eventName, payload, errCode, errMsg)
  })
}

export function ensureNativeEventsBound() {
  if (nativeEventsBound == false) {
    bindNativeEvents()
    nativeEventsBound = true
  }
}

export function offSDKEventName(eventName : OpenIMSDKEventName) {
  switch (eventName) {
    case 'onConnecting':
      onConnectingHandlers = []
      onConnectingHandlerIDs = []
