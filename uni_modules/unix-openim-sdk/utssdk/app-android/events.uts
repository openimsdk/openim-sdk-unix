        const onConnectingCurrentHandler = onConnectingHandlers[onConnectingCopyIndex]
        if (onConnectingCurrentHandler != null) { onConnectingDispatchSnapshot.push(onConnectingCurrentHandler) }
      }
      for (let onConnectingDispatchIndex : number = 0; onConnectingDispatchIndex < onConnectingDispatchSnapshot.length; onConnectingDispatchIndex = onConnectingDispatchIndex + 1) {
        const onConnectingDispatchHandler = onConnectingDispatchSnapshot[onConnectingDispatchIndex]
        if (onConnectingDispatchHandler != null) {
          try { onConnectingDispatchHandler() } catch (error) { console.error('[unix-openim-sdk] onConnecting handler failed', error) }
        }
      }
