function removeOnConnectingHandler(subscriptionID : string) {
  const nextHandlers : Array<OpenIMVoidEventHandler> = []
  const nextHandlerIDs : Array<string> = []
  for (let index : number = 0; index < onConnectingHandlerIDs.length; index = index + 1) {
    const currentID = onConnectingHandlerIDs[index]
    const currentHandler = onConnectingHandlers[index]
    if (currentID != null && currentHandler != null && currentID != subscriptionID) {
      nextHandlerIDs.push(currentID)
      nextHandlers.push(currentHandler)
    }
  }
  onConnectingHandlerIDs = nextHandlerIDs
  onConnectingHandlers = nextHandlers
}

