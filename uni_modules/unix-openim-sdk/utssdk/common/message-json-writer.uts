import { buildJSONField, stringifyJSONNumber, stringifyJSONBoolean, appendJSONText, appendOptionalJSONStringText, appendOptionalJSONNumberText, appendOptionalJSONBooleanText, stringifyStringList, stringifyOpenIMMessageEntityList } from './native-call-common.uts'
import {
  OpenIMAdvancedTextElem,
  OpenIMAtTextElem,
  OpenIMAtUsersInfoItem,
  OpenIMCardElem,
  OpenIMFaceElem,
  OpenIMFileElem,
  OpenIMLocationElem,
  OpenIMCustomElem,
  OpenIMMessageItem,
  OpenIMMessageItemRef,
  OpenIMMergeElem,
  OpenIMPicture,
  OpenIMPictureElem,
  OpenIMQuoteElem,
  OpenIMSoundElem,
  OpenIMAttachedGroupHasReadInfo,
  OpenIMAttachedInfoElem,
  OpenIMTextElem,
  OpenIMVideoElem,
  OpenIMUploadProgress
} from '../interface.uts'

const rememberedOpenIMMessageIDs : Array<string> = []
const rememberedOpenIMMessageJSON : Array<string> = []
const rememberedOpenIMMessageLimit : number = 256

function readRememberedOpenIMMessageJSON(message : OpenIMMessageItem) : string | null {
  if (message.clientMsgID == null || (message.clientMsgID as string).length == 0) { return null }
  const clientMsgID = message.clientMsgID as string
  let index = rememberedOpenIMMessageIDs.length - 1
  while (index >= 0) {
    if (rememberedOpenIMMessageIDs[index] == clientMsgID) { return rememberedOpenIMMessageJSON[index] }
    index = index - 1
  }
  return null
}

export function rememberOpenIMMessageJSON(message : OpenIMMessageItem | null, data : string) {
  if (message == null || message.clientMsgID == null || (message.clientMsgID as string).length == 0) { return }
  const json = data.trim()
  if (json.length < 2 || json.substring(0, 1) != '{' || json.substring(json.length - 1) != '}') { return }
  const clientMsgID = message.clientMsgID as string
  let index = rememberedOpenIMMessageIDs.length - 1
  while (index >= 0) {
    if (rememberedOpenIMMessageIDs[index] == clientMsgID) {
      rememberedOpenIMMessageJSON[index] = json
      return
    }
    index = index - 1
  }
  rememberedOpenIMMessageIDs.push(clientMsgID)
  rememberedOpenIMMessageJSON.push(json)
  if (rememberedOpenIMMessageIDs.length > rememberedOpenIMMessageLimit) {
    rememberedOpenIMMessageIDs.shift()
    rememberedOpenIMMessageJSON.shift()
  }
}

export function stringifyOpenIMPicture(value : OpenIMPicture | null) : string {
  if (value == null) { return '{}' }
  let text = ''
  text = appendOptionalJSONStringText(text, 'uuid', value.uuid)
  text = appendOptionalJSONStringText(text, 'type', value.type)
  text = appendOptionalJSONNumberText(text, 'size', value.size)
  text = appendOptionalJSONNumberText(text, 'width', value.width)
  text = appendOptionalJSONNumberText(text, 'height', value.height)
  text = appendOptionalJSONStringText(text, 'url', value.url)
  return '{' + text + '}'
}

function stringifyOpenIMPictureElem(value : OpenIMPictureElem) : string {
  let text = ''
  text = appendOptionalJSONStringText(text, 'sourcePath', value.sourcePath)
  if (value.sourcePicture != null) { text = appendJSONText(text, buildJSONField('sourcePicture', stringifyOpenIMPicture(value.sourcePicture))) }
  if (value.bigPicture != null) { text = appendJSONText(text, buildJSONField('bigPicture', stringifyOpenIMPicture(value.bigPicture))) }
  if (value.snapshotPicture != null) { text = appendJSONText(text, buildJSONField('snapshotPicture', stringifyOpenIMPicture(value.snapshotPicture))) }
  return '{' + text + '}'
}

function stringifyOpenIMMessageContentElem(content ?: string | null) : string | null {
  if (content != null && (content as string).length > 0) { return content as string }
  return null
}

function stringifyOpenIMPictureElemForMessage(message : OpenIMMessageItem) : string {
  const content = stringifyOpenIMMessageContentElem(message.content)
  if (content != null) { return content }
  if (message.pictureElem != null) { return stringifyOpenIMPictureElem(message.pictureElem as OpenIMPictureElem) }
  return '{}'
}

