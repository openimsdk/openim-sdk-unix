{
  "name": "openim-sdk-unix-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "tsx tooling/src/cli.ts generate",
    "generate": "tsx tooling/src/cli.ts generate",
    "contract:import": "tsx tooling/src/cli.ts contract:import",
    "contract:ids:init": "tsx tooling/src/cli.ts contract:ids:init",
    "verify": "tsx tooling/src/cli.ts verify",
    "verify:surface": "tsx tooling/src/cli.ts verify:surface",
    "verify:generated": "tsx tooling/src/cli.ts verify:generated",
    "verify:policy": "tsx tooling/src/cli.ts verify:policy",
    "verify:consumer:android": "tsx tooling/src/cli.ts verify:consumer --platform android",
    "verify:consumer:ios": "tsx tooling/src/cli.ts verify:consumer --platform ios",
    "native:import": "tsx tooling/src/cli.ts native:import",
    "native:verify": "tsx tooling/src/cli.ts native:verify",
    "enterprise:import": "tsx tooling/src/cli.ts enterprise:import",
    "enterprise:ids:init": "tsx tooling/src/cli.ts enterprise:ids:init",
    "enterprise:verify": "tsx tooling/src/cli.ts enterprise:verify",
    "enterprise:bootstrap": "tsx tooling/src/cli.ts enterprise:bootstrap",
    "enterprise:monomorphize-harmony": "tsx tooling/src/cli.ts enterprise:monomorphize-harmony",
    "compile:public": "tsx tooling/src/cli.ts compile --platform all",
    "compile:local": "tsx tooling/src/cli.ts compile --platform all --native-profile local",
    "compile:local:android": "tsx tooling/src/cli.ts compile --platform android --native-profile local",
    "compile:local:ios": "tsx tooling/src/cli.ts compile --platform ios --native-profile local",
    "compile:android": "tsx tooling/src/cli.ts compile --platform android",
    "compile:ios": "tsx tooling/src/cli.ts compile --platform ios",
    "compile:private": "tsx tooling/src/cli.ts compile-private",
    "build:private": "tsx tooling/src/cli.ts build-private",
    "test:tooling": "tsx --test tooling/tests/**/*.test.ts",
    "typecheck:tooling": "tsc -p tooling/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
