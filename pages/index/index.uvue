	type OpenIMAutomationConfig = {
		autorun : string
		suiteFilter : string
		apiAddr : string
		wsAddr : string
		platformID : number
		primaryUserID : string
		primaryToken : string
		primaryIOSToken : string
		primaryAndroidToken : string
		secondaryUserID : string
		secondaryToken : string
		secondaryIOSToken : string
		secondaryAndroidToken : string
	}

	type OpenIMAutomationEventCorrelation = {
		operationApiName : string
		eventName : string
		operationSequence : number
		eventSequence : number
		operationEpoch : number
		eventEpoch : number
		payloadMatched : boolean
		correlationKind : string
		operationTerminalSequence : number
		exclusiveOperation : boolean
		payloadIdentity : string
		eventPayloadDetail : string
	}

	type OpenIMAutomationOperationWindow = {
		operationApiName : string
		operationSequence : number
		operationEpoch : number
		payloadNeedle : string
		resultIdentity : string
		terminalSequence : number
		exclusiveOperation : boolean
	}

	type OpenIMAutomationEventOccurrence = {
		eventName : string
		payloadText : string
		sequence : number
		epoch : number
	}

	type OpenIMAutomationAssertionResult = {
		path : string
		axis : string
		profile : string
		rule : string
		expected : string
		actual : string
		ok : boolean
	}

	type OpenIMAutomationCase = {
		group : string
		name : string
		apiName : string
		status : string
		message : string
		durationMs : number
		invoked : boolean
		resolved : boolean
		responseEvidence : boolean
		responseEncoding : string
		responseDetail : string
		structureValidated : boolean
		semanticValidated : boolean
		sideEffectValidated : boolean
		eventCorrelated : boolean
		negativeValidated : boolean
		negativeProfile : string
		cleanupValidated : boolean
		cleanupAction : string
		errCode : number
		eventCorrelations : Array<OpenIMAutomationEventCorrelation>
		assertions : Array<OpenIMAutomationAssertionResult>
	}

	type OpenIMAutomationEvidence = {
		structureValidated : boolean
		semanticValidated : boolean
		sideEffectValidated : boolean
		eventCorrelated : boolean
		cleanupValidated : boolean
		cleanupAction : string
		assertions : Array<OpenIMAutomationAssertionResult>
	}

	type OpenIMAutomationGroupResult = {
		group : string
		total : number
		passed : number
		failed : number
		skipped : number
	}

	type OpenIMAutomationEventRecord = {
		name : string
		eventName : string
		count : number
		lastPayload : string
		payloadEvidence : boolean
		payloadEncoding : string
		payloadDetail : string
		payloadDetails : Array<string>
		deliveryValidated : boolean
		structureValidated : boolean
		semanticValidated : boolean
		orderingValidated : boolean
		epochValidated : boolean
		cleanupValidated : boolean
		cleanupAction : string
	}

	type OpenIMAutomationSummary = {
		headline : string
		summaryText : string
		suiteFilter : string
		executedSuites : Array<string>
		total : number
		passed : number
		failed : number
		skipped : number
		coverageTotal : number
