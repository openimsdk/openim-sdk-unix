	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk7())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk8())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk9())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk10())
	return entries
}

