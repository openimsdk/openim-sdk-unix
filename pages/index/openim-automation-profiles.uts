function appendOpenIMAutomationProfileEntries(target : Array<OpenIMAutomationProfileEntry>, source : Array<OpenIMAutomationProfileEntry>) {
	let index = 0
	while (index < source.length) {
		target.push(source[index])
		index = index + 1
	}
}

function buildOpenIMAutomationProfileEntries() : Array<OpenIMAutomationProfileEntry> {
	const entries : Array<OpenIMAutomationProfileEntry> = []
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk0())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk1())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk2())
	appendOpenIMAutomationProfileEntries(entries, openIMAutomationProfileEntriesChunk3())
