function appendOpenIMAutomationEventProfileEntries(target : Array<OpenIMAutomationEventProfileEntry>, source : Array<OpenIMAutomationEventProfileEntry>) {
	let index = 0
	while (index < source.length) {
		target.push(source[index])
		index = index + 1
	}
}

function buildOpenIMAutomationEventProfileEntries() : Array<OpenIMAutomationEventProfileEntry> {
	const entries : Array<OpenIMAutomationEventProfileEntry> = []
	appendOpenIMAutomationEventProfileEntries(entries, openIMAutomationEventProfileEntriesChunk0())
	appendOpenIMAutomationEventProfileEntries(entries, openIMAutomationEventProfileEntriesChunk1())
	appendOpenIMAutomationEventProfileEntries(entries, openIMAutomationEventProfileEntriesChunk2())
	return entries
}

export const openIMAutomationEventProfileEntries : Array<OpenIMAutomationEventProfileEntry> = buildOpenIMAutomationEventProfileEntries()
