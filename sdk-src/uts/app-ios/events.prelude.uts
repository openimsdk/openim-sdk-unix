function readBooleanPayload(payload : string) : boolean { return payload == 'true' }
function readNumberPayload(payload : string) : number { return parseFloat(payload) }
function parseSendMessageProgress(payload : string) : OpenIMSendMessageProgressEvent | null { return JSON.parseObject<OpenIMSendMessageProgressEvent>(payload) }
